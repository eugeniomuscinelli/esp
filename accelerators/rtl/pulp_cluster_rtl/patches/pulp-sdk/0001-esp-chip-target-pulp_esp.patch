diff --git a/rtos/pulpos/pulp/kernel/chips/pulp_esp/link.ld b/rtos/pulpos/pulp/kernel/chips/pulp_esp/link.ld
new file mode 100644
index 0000000..b38e5e8
--- /dev/null
+++ b/rtos/pulpos/pulp/kernel/chips/pulp_esp/link.ld
@@ -0,0 +1,300 @@
+
+OUTPUT_ARCH(riscv)
+ENTRY( _start )
+MEMORY
+{
+  /* ESP: L2 is the 3 MiB DMA window (L2BaseAddr/L2Size in the wrapper);
+   * L1 is the 128 KiB cluster TCDM at ClustBase. The PE release flag in
+   * crt0.S lives at ORIGIN(L1) + (LENGTH(L1) - 0x10) + 4 = 0x5001FFF0. */
+  L2           : ORIGIN = 0xA0103680, LENGTH = 0x00300000
+  L2_aliased   : ORIGIN = 0x00000000, LENGTH = 0x0001fffc
+  L1           : ORIGIN = 0x50000000, LENGTH = 0x0001fffc
+  L1_aliased   : ORIGIN = 0x00000000, LENGTH = 0x0001fffc
+}
+
+/*
+ * This linker script try to put FC data in L2 private bank0 and FC code 
+ * in L2 private bank1 to avoid contention between FC code and data
+ * as FC has no instruction cache and is so often accessing L2 to
+ * get instructions. Everything can be shifted in case one bank is full.
+ *
+ * Cluster code and initialized data are put in shared banks to not polute
+ * private banks which are quite small, and also avoid contentions between
+ * cluster cache refill and FC.
+ */
+
+
+SECTIONS
+{
+  /*
+   * L2 PRIVATE BANK0
+   *
+   * Contains FC data
+   */
+
+  /* This section is for tiny FC data which benefits 
+   * from the alias at 0
+   */
+
+  .data_tiny_fc :
+  {
+    . = ALIGN(4);
+    *(.data_tiny_fc)
+    *(.data_tiny_fc.*)
+  } > L2
+
+
+  .init :
+  {
+    . = ALIGN(4);
+    KEEP( *(.init) )
+  } > L2
+
+
+  .fini :
+  {
+    . = ALIGN(4);
+    KEEP( *(.fini) )
+  } > L2
+
+
+  .preinit_array : {
+    . = ALIGN(4);
+    PROVIDE_HIDDEN (__preinit_array_start = .);
+    KEEP (*(.preinit_array))
+    PROVIDE_HIDDEN (__preinit_array_end = .);
+  } > L2
+
+
+  .init_array : {
+    . = ALIGN(4);
+    PROVIDE_HIDDEN (__init_array_start = .);
+    __CTOR_LIST__ = .;
+    LONG((__CTOR_END__ - __CTOR_LIST__) / 4 - 2)
+    KEEP(*(.ctors.start))
+    KEEP(*(.ctors))
+    KEEP (*(SORT(.init_array.*)))
+    KEEP (*(.init_array ))
+    LONG(0)
+    __CTOR_END__ = .;
+    PROVIDE_HIDDEN (__init_array_end = .);
+  } > L2
+
+
+  .fini_array : {
+    . = ALIGN(4);
+    PROVIDE_HIDDEN (__fini_array_start = .);
+    __DTOR_LIST__ = .;
+    LONG((__DTOR_END__ - __DTOR_LIST__) / 4 - 2)
+    KEEP(*(.dtors.start))
+    KEEP(*(.dtors))
+    LONG(0)
+    __DTOR_END__ = .;
+    KEEP (*(SORT(.fini_array.*)))
+    KEEP (*(.fini_array ))
+    PROVIDE_HIDDEN (__fini_array_end = .);
+  } > L2
+
+
+  .boot : {
+    . = ALIGN(4);
+    *(.boot)
+    *(.boot.data)
+  } > L2
+
+
+  .rodata : {
+    . = ALIGN(4);
+    *(.rodata);
+    *(.rodata.*)
+    *(.srodata);
+    *(.srodata.*)
+    *(.eh_frame*)
+  } > L2
+
+
+  .got : {
+    . = ALIGN(4);
+    *(.got.plt) * (.igot.plt) *(.got) *(.igot)
+  } > L2
+
+
+  .shbss : {
+    . = ALIGN(4);
+    *(.shbss)
+  } > L2
+
+
+  .talias : {
+  } > L2
+
+
+  .gnu.offload_funcs : {
+    . = ALIGN(4);
+    KEEP(*(.gnu.offload_funcs))
+  } > L2
+
+
+  .gnu.offload_vars : {
+    . = ALIGN(4);
+    KEEP(*(.gnu.offload_vars))
+  } > L2
+
+
+  .stack : {
+    . = ALIGN(4);
+    . = ALIGN(16);
+    stack_start = .;
+    . = . + 0x800;
+    stack = .;
+  } > L2
+
+
+  __l2_priv0_end = ALIGN(4);
+
+
+
+
+  /*
+   * L2 PRIVATE BANK1
+   *
+   * Contains FC code
+   */
+
+  .vectors MAX(ORIGIN(L2)+0x8000,ALIGN(256)) :
+  {
+    __irq_vector_base = .;
+    KEEP(*(.vectors))
+  } > L2
+
+  .text :
+  {
+    . = ALIGN(4);
+    _stext = .;
+    *(.text)
+    *(.text.*)
+    *(.text_l2)
+    *(.text_l2.*)
+    _etext  =  .;
+    *(.lit)
+    *(.shdata)
+    _endtext = .;
+    . = ALIGN(4);
+  } > L2
+
+  __l2_priv1_end = ALIGN(4);
+
+
+  /*
+   * L2 SHARED BANKS
+   *
+   * Contains other data such as peripheral data and cluster code and data
+   */
+  .bss : {
+    . = ALIGN(8);
+    _bss_start = .;
+    *(.bss)
+    *(.bss.*)
+    *(.sbss)
+    *(.sbss.*)
+    *(COMMON)
+    . = ALIGN(4);
+    _bss_end = .;
+  } > L2
+
+  .data : {
+    . = ALIGN(4);
+    sdata  =  .;
+    _sdata  =  .;
+    *(.data_fc)
+    *(.data_fc.*)
+    *(.sdata);
+    *(.sdata.*)
+    *(.heapl2ram)
+    *(.fcTcdm)
+    *(.fcTcdm.*)
+    *(.fcTcdm_g)
+    *(.fcTcdm_g.*)
+    . = ALIGN(4);
+    edata  =  .;
+    _edata  =  .;
+  } > L2
+
+
+  .l2_data MAX(ORIGIN(L2)+0x10000,ALIGN(4)) :
+  {
+    . = ALIGN(4);
+    __cluster_text_start = .;
+    *(.cluster.text)
+    *(.cluster.text.*)
+    . = ALIGN(4);
+    __cluster_text_end = .;
+    *(.data);
+    *(.data.*)
+    *(.l2_data)
+    *(.l2_data.*)
+    *(.data_fc_shared)
+    *(.data_fc_shared.*)
+    . = ALIGN(4);
+  } > L2
+
+  /* Following sections are keeping the cluster data
+   * in L2 until the cluster is powered up */
+
+  _l1_preload_start_inL2 = ALIGN(4);
+
+  .data_tiny_l1 :
+  {
+    . = ALIGN(4);
+    _l1_preload_start = .;
+    *(.data_tiny_l1)
+    *(.data_tiny_l1.*)
+    *(.data_alias_l1)
+    *(.data_alias_l1.*)
+  /* ESP: place in real L1, not the alias-at-0 window. The "tiny" 12-bit
+   * addressing that L1_aliased exists for is inert here (CONFIG_NO_STD_RELOC
+   * is not set), and a real address lets the startup copy below use the symbol
+   * directly instead of going through pos_cluster_tiny_addr(). */
+  } > L1 AT> L2
+
+  .l1cluster_g (ORIGIN(L1) + SIZEOF(.data_tiny_l1)): {
+    . = ALIGN(4);
+    *(.heapsram)
+    *(.heapsram.*)
+    *(.l1cluster_g)
+    *(.l1cluster_g.*)
+    *(.data_l1)
+    *(.data_l1.*)
+    . = ALIGN(4);
+    _libgomp_start = .;
+    *(.libgomp)
+    *(.libgomp.*)
+    . = ALIGN(4);
+  } > L1 AT> L2
+
+  .bss_l1 (ORIGIN(L1) + SIZEOF(.data_tiny_l1) + SIZEOF(.l1cluster_g)) : {
+    . = ALIGN(4);
+    /* ESP: crt0's bss clear only covers the L2 .bss (_bss_start.._bss_end), so
+     * .bss_l1 is left as whatever the TCDM SRAM powered up with. These bounds
+     * let cluster_start() zero it explicitly. */
+    __bss_l1_start = .;
+    *(.bss_l1)
+    *(.bss_l1.*)
+    . = ALIGN(4);
+    __bss_l1_end = .;
+  } > L1 AT> L2
+
+  __l1_end = ALIGN(4);
+
+  __l2_shared_end = LOADADDR(.bss_l1) + SIZEOF(.bss_l1);
+
+
+
+
+  _l1_preload_size = SIZEOF(.data_tiny_l1) + SIZEOF(.l1cluster_g);
+
+  __cluster_text_size = __cluster_text_end - __cluster_text_start;
+
+  __l1_heap_start = ALIGN(4);
+  __l1_heap_size = LENGTH(L1) - __l1_heap_start + ORIGIN(L1);
+}
diff --git a/rtos/pulpos/pulp/kernel/chips/pulp_esp/soc.c b/rtos/pulpos/pulp/kernel/chips/pulp_esp/soc.c
new file mode 100644
index 0000000..d9e2bde
--- /dev/null
+++ b/rtos/pulpos/pulp/kernel/chips/pulp_esp/soc.c
@@ -0,0 +1,41 @@
+/*
