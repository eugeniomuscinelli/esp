diff --git a/configs/pulp_cluster_esp.sh b/configs/pulp_cluster_esp.sh
new file mode 100644
index 0000000..5347a94
--- /dev/null
+++ b/configs/pulp_cluster_esp.sh
@@ -0,0 +1,36 @@
+#! /bin/bash
+
+
+if [  -n "${ZSH_VERSION:-}" ]; then 
+	DIR="$(readlink -f -- "${(%):-%x}")"
+	DIRNAME="$(dirname $DIR)"
+	PULP_SDK_HOME=$(dirname $DIRNAME)
+	export PULP_SDK_HOME
+	#echo $(dirname "$(readlink -f ${(%):-%N})")
+else
+	export PULP_SDK_HOME="$(dirname $(dirname "$(readlink -f "${BASH_SOURCE[0]}")"))"
+fi
+
+export TARGET_CHIP_FAMILY="PULP"
+export TARGET_CHIP="PULP_ESP"
+export TARGET_NAME="pulp"
+export BOARD_NAME=pulp
+export CONFIG_NO_FC=1
+export PULPOS_BOARD=pulp
+export PULPOS_BOARD_VERSION=pulp
+export PULPOS_BOARD_PROFILE=pulp
+export PULPOS_TARGET=pulp_esp
+export PULPOS_SYSTEM=pulp
+export GAPY_TARGET=pulp
+export GAPY_V2_TARGET=pulp-open
+export PULPOS_MODULES="$PULP_SDK_HOME/rtos/pulpos/pulp $PULP_SDK_HOME/rtos/pmsis/pmsis_bsp"
+
+# PULP-fork GCC (v1.0.16). Its cc1 needs libmpfr.so.6, which RHEL 8 does not
+# provide (it ships libmpfr.so.4), so a local copy is placed in the toolchain's
+# own lib/ and pointed at here. Keeps the toolchain self-contained.
+export PULP_RISCV_GCC_TOOLCHAIN=${PULP_RISCV_GCC_TOOLCHAIN:-$HOME/toolchains/v1.0.16-pulp-riscv-gcc-ubuntu-18}
+export LD_LIBRARY_PATH="$PULP_RISCV_GCC_TOOLCHAIN/lib:$LD_LIBRARY_PATH"
+
+export GAPY_PY_TARGET=Pulp_open_board@pulp_open.pulp_open_board
+
+source $PULP_SDK_HOME/configs/common.sh
