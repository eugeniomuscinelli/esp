+
+
+#define POS_FLL_CL 2
+#define POS_FLL_PERIPH 1
+#define POS_FLL_FC 0
+
+extern PI_FC_TINY int pos_freq_domains[ARCHI_NB_FLL];
+
+static inline void pos_pmu_cluster_power_up()
+{}
+
+void pos_soc_init();
+
+static inline int pos_freq_get_fll(int domain)
+{
