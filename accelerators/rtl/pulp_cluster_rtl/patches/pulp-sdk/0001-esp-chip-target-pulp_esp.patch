# What it adds: configs/pulp_cluster_esp.sh (environment for the target), the
# pulp_esp chip under rtos/pulpos/pulp (link.ld, soc.c, config, target rules)
# and its archi/hal headers, plus five edits to shared PulpOS files (crt0.S,
# init.c, link.h, pulp_defs.h, riscv_v5.h) for the no-fabric-controller boot.
diff --git a/rtos/pulpos/common/include/pos/implem/link.h b/rtos/pulpos/common/include/pos/implem/link.h
index eef07c9..26a1c02 100644
--- a/rtos/pulpos/common/include/pos/implem/link.h
+++ b/rtos/pulpos/common/include/pos/implem/link.h
@@ -35,6 +35,11 @@ extern char _l1_preload_start_inL2[];
 extern char _l1_preload_start[];
 extern char _l1_preload_size[];
 
+/* Bounds of .bss_l1, defined by the ESP linker script so cluster_start() can
+ * zero it (crt0's clear covers only the L2 .bss). */
+extern unsigned char __bss_l1_start;
+extern unsigned char __bss_l1_end;
+
 
 #if defined(ARCHI_HAS_L2)
 
diff --git a/rtos/pulpos/common/kernel/crt0.S b/rtos/pulpos/common/kernel/crt0.S
index 1d841d1..c16a5ba 100644
--- a/rtos/pulpos/common/kernel/crt0.S
+++ b/rtos/pulpos/common/kernel/crt0.S
@@ -35,10 +35,22 @@ pos_init_entry:
     csrr    a0, 0xF14
     andi    a1, a0, 0x1f
     #ifdef ARCHI_NO_FC
+# Address of the PE release flag, at the top of L1 (TCDM top - 0x10).
+# Defined once and used at BOTH sites below: this site clears it and leaves it
+# in t0 for sync_loop to poll, while PE0 sets it after pos_init_start. If the
+# two sites disagree the PEs never wake, so they must never be edited apart.
+#if PULP_CHIP == CHIP_PULP_ESP
+# ESP wrapper TcdmSize = 128 KiB at 0x50000000
+#define POS_PE_SYNC_FLAG 0x5001FFF0
+#elif PULP_CHIP == CHIP_CARFIELD || PULP_CHIP == CHIP_ASTRAL
+#define POS_PE_SYNC_FLAG 0x5003FFF0
+#else
+#define POS_PE_SYNC_FLAG 0x1003FFF0
+#endif
     # PEs from 1 to 7 will go to sync_loop and wait. PE0 will reach them
     # later after the pos_init_start. Then, they'll set up their stack into
     # the L1 and jump to cluster_entry_stub
-    li t0, 0x1003FFF0
+    li t0, POS_PE_SYNC_FLAG
     sw x0, 0(t0)
     # We check if the offset of the core is zero, so that even if the cluster
     # ID is not zero, the execution does not break here
@@ -89,13 +101,7 @@ pos_init_entry:
 #ifdef ARCHI_NO_FC
     csrr    a0, 0xF14
     andi    a1, a0, 0x1f
-#if PULP_CHIP == CHIP_CARFIELD
-    li t0, 0x5003FFF0
-#elif PULP_CHIP == CHIP_ASTRAL
-    li t0, 0x5003FFF0
-#else
-    li t0, 0x1003FFF0
-#endif
+    li t0, POS_PE_SYNC_FLAG
     li t1, 0x1
     sw t1, 0(t0)
     j pe_start
diff --git a/rtos/pulpos/common/kernel/init.c b/rtos/pulpos/common/kernel/init.c
index 3e84f46..367becc 100644
--- a/rtos/pulpos/common/kernel/init.c
+++ b/rtos/pulpos/common/kernel/init.c
@@ -111,6 +111,34 @@ void cluster_start(int cid, int (*entry)())
     #ifndef ARCHI_NO_FC
     pos_fll_init(POS_FLL_CL);
     #endif
+
+#if PULP_CHIP == CHIP_PULP_ESP
+    /* ESP: on a normal PULP chip the fabric controller does this from
+     * pi_cluster_open() -> pos_init_cluster_data(). There is no FC here, so
+     * that path is never taken and nothing else preloads TCDM: the host only
+     * loads the L2 window. Initialised cluster-L1 variables would therefore
+     * start as whatever the TCDM SRAM held, and .bss_l1 would never be zeroed
+     * (crt0 clears only _bss_start.._bss_end, which brackets the L2 .bss).
+     *
+     * The linker keeps a copy of the initialised L1 data in L2 (AT> L2), which
+     * on ESP rides inside the loaded window, so we can copy it into place here.
+     * Runs on core 0 only, before the other PEs are released. */
+    {
+        int *dst  = (int *)_l1_preload_start;
+        int *src  = (int *)_l1_preload_start_inL2;
+        int  size = (int)_l1_preload_size;
+
+        for (; size > 0; size -= 4)
+            *dst++ = *src++;
+
+        int *bss     = (int *)&__bss_l1_start;
+        int *bss_end = (int *)&__bss_l1_end;
+
+        while (bss < bss_end)
+            *bss++ = 0;
+    }
+#endif
+
     // Initialize cluster L1 memory allocator
     pos_alloc_init_l1(cid);
 
@@ -160,7 +188,18 @@ void pos_init_start()
   pos_io_start();
 
   // Now now the minimal init are done, we can activate interruptions
+#if PULP_CHIP == CHIP_PULP_ESP
+  /* ESP: interrupts stay masked. RI5CY derives its trap base from the boot
+   * address register as mtvec = boot_addr[30:7], and the exception PC is
+   * {mtvec, 8'h0} -- which for this window base does not reproduce
+   * __irq_vector_base, so a trap would vector into unmapped space. Nothing on
+   * the standalone-cluster path needs interrupts (synchronisation is the
+   * hardware event unit, timing is the polled cluster timer), so the safe and
+   * honest thing is to leave them off until the trap base is pinned down in
+   * simulation. */
+#else
   hal_irq_enable();
+#endif
 
 #ifdef ARCHI_NO_FC
   cluster_start(hal_cluster_id(), main);
