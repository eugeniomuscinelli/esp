+++ b/rtos/pulpos/pulp_hal/include/hal/riscv/riscv_v5.h
@@ -157,7 +157,16 @@ static inline unsigned int cluster_id() {  int hart_id;
   asm("csrr %0, 0xF10" : "=r" (hart_id) : );
 #endif
   // in PULP the hart id is {22'b0, cluster_id, core_id}
+#if PULP_CHIP == CHIP_PULP_ESP
+  // ESP: the wrapper drives cluster_id_i = 1, so the cores read hart ids
+  // 0x20-0x27 and the classic >>5 reports cluster 1. Every
+  // ARCHI_*_GLOBAL_ADDR(cid) would then land 4 MiB past the cluster (EoC at
+  // 0x50600000, L1 heap outside TCDM, printf shifted by 0x80). Shift by 6 so
+  // this single cluster presents as index 0. core_id (& 0x1f) is unaffected.
+  return (hart_id >> 6);
+#else
   return (hart_id >> 5) & 0x3f;
+#endif
 }
 
 #ifndef PLP_NO_BUILTIN
@@ -168,8 +177,14 @@ static inline unsigned int hal_core_id() {
 }
 
 static inline unsigned int hal_cluster_id() {
+#if PULP_CHIP == CHIP_PULP_ESP
+  // Must go through cluster_id(): the builtin encodes the classic >>5 decode
+  // and would bypass the ESP shift above.
+  return cluster_id();
+#else
   //return cluster_id();
   return __builtin_pulp_ClusterId();
+#endif
 }
 
 // TODO replace by compiler builtin
@@ -219,7 +234,16 @@ static inline __attribute__((always_inline)) unsigned int hal_cluster_id() {
   asm("csrr %0, 0xF10" : "=r" (hart_id) : );
 #endif
   // in PULP the hart id is {22'b0, cluster_id, core_id}
+#if PULP_CHIP == CHIP_PULP_ESP
+  // ESP: the wrapper drives cluster_id_i = 1, so the cores read hart ids
+  // 0x20-0x27 and the classic >>5 reports cluster 1. Every
+  // ARCHI_*_GLOBAL_ADDR(cid) would then land 4 MiB past the cluster (EoC at
+  // 0x50600000, L1 heap outside TCDM, printf shifted by 0x80). Shift by 6 so
+  // this single cluster presents as index 0. core_id (& 0x1f) is unaffected.
+  return (hart_id >> 6);
+#else
   return (hart_id >> 5) & 0x3f;
+#endif
 }
 
