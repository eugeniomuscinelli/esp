       .rst_ni    ( rst_ni       ),
@@ -118,5 +124,11 @@ module mock_uart_axi #(
       .pready_o  ( uart_pready  ),
       .pslverr_o ( uart_pslverr )
  );
+`else
+  // always-ready OK sink so accesses to the UART window complete
+  assign uart_prdata  = 32'h0;
+  assign uart_pready  = 1'b1;
+  assign uart_pslverr = 1'b0;
+`endif
 
 endmodule
